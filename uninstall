#!/bin/bash
set -e

REPO_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

echo "[nvim] Removing config..."
if [ -L "$HOME/.config/nvim" ]; then
    rm "$HOME/.config/nvim"
elif [ -d "$HOME/.config/nvim" ]; then
    # Only remove if it's not the repo itself
    if [ "$(realpath "$HOME/.config/nvim")" != "$REPO_DIR" ]; then
        rm -rf "$HOME/.config/nvim"
    else
        echo "[nvim] $HOME/.config/nvim is the repo — skipping"
    fi
fi

echo "[nvim] Removing plugin data..."
rm -rf "$HOME/.local/share/nvim"

echo "[nvim] Removing cache..."
rm -rf "$HOME/.cache/nvim"

echo "[nvim] Removing state..."
rm -rf "$HOME/.local/state/nvim"

if [ -f /usr/local/bin/win32yank.exe ]; then
    echo "[nvim] Removing win32yank..."
    sudo rm /usr/local/bin/win32yank.exe
fi

echo ""
echo "[nvim] Done. Delete the repo folder to finish."
